{
  "name": "packai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "PackAI: Standards-first bundle, pre-flight provisioning & cross-client distribution monorepo",
  "workspaces": [
    "cli",
    "marketplace"
  ],
  "scripts": {
    "test": "npm test --workspace=cli",
    "build:cli": "echo 'CLI is native ESM'",
    "build:marketplace": "npm run build --workspace=marketplace",
    "build": "npm run build:marketplace",
    "dev:marketplace": "npm run dev --workspace=marketplace",
    "dev": "npm run dev:marketplace"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
